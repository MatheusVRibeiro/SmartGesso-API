generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformAdminStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyUserRole {
  COMPANY_OWNER
  MANAGER
  SALES
  FINANCE
  INSTALLER
  PRODUCTION
}

enum CompanyMemberStatus {
  ATIVO
  INATIVO
  CONVIDADO
}

enum BillingType {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model PlatformAdmin {
  id           String              @id @default(uuid()) @db.Char(36)
  name         String
  email        String              @unique
  passwordHash String              @db.VarChar(255)
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
}

model Company {
  id                    String              @id @default(uuid()) @db.Char(36)
  legalName             String
  tradeName             String
  documentType          String
  document              String              @unique
  stateRegistration     String?
  municipalRegistration String?
  email                 String?
  phone                 String?
  whatsapp              String?
  status                CompanyStatus       @default(ACTIVE)
  timezone              String              @default("America/Sao_Paulo")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  addresses             CompanyAddress[]
  branding              CompanyBranding?
  subscriptions         Subscription[]
  members               CompanyMember[]
  clients               Client[]
  works                 Work[]
  products              Product[]
  services              Service[]
  materials             Material[]
  measurements          Measurement[]
  compositions          Composition[]
  quotes                Quote[]
  quoteEnvironments     QuoteEnvironment[]
  payments              Payment[]
  expenses              Expense[]
  serviceOrders         ServiceOrder[]
  productionOrders      ProductionOrder[]
  scheduleEvents        ScheduleEvent[]
  inventoryMovements    InventoryMovement[]
  pushTokens            PushToken[]
  notifications         Notification[]
  companySequences      CompanySequence[]
}

// ─── ETAPA 4 — Numeração concorrente segura ────────────────────────────────

enum SequenceEntityType {
  QUOTE
  SERVICE_ORDER
}

model CompanySequence {
  companyId    String              @db.Char(36)
  entityType   SequenceEntityType
  currentValue Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id])

  @@id([companyId, entityType])
  @@index([companyId])
}

model CompanyAddress {
  id         String   @id @default(uuid()) @db.Char(36)
  companyId  String   @db.Char(36)
  type       String
  postalCode String?
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  country    String   @default("BR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])
}

model CompanyBranding {
  id                  String   @id @default(uuid()) @db.Char(36)
  companyId           String   @unique @db.Char(36)
  displayName         String
  logoUrl             String?
  primaryColor        String?
  secondaryColor      String?
  commercialEmail     String?
  commercialPhone     String?
  commercialWhatsapp  String?
  website             String?
  instagram           String?
  quoteFooter         String?
  defaultWarrantyText String?
  pixKey              String?
  bankInformation     String?  @db.Text
  showSmartGessoBrand Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id])
}

model Plan {
  id                  String         @id @default(uuid()) @db.Char(36)
  name                String
  code                String         @unique
  description         String?        @db.Text
  billingType         BillingType
  defaultPrice        Decimal        @db.Decimal(15, 2)
  maxUsers            Int
  maxStorageMb        Int
  features            Json
  showSmartGessoBrand Boolean        @default(true)
  status              PlanStatus     @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
}

model Subscription {
  id                       String                    @id @default(uuid()) @db.Char(36)
  companyId                String                    @db.Char(36)
  planId                   String                    @db.Char(36)
  startDate                DateTime
  endDate                  DateTime
  gracePeriodEnd           DateTime
  status                   SubscriptionStatus
  billingType              BillingType
  agreedPrice              Decimal                   @db.Decimal(15, 2)
  autoRenew                Boolean                   @default(false)
  cancelledAt              DateTime?
  cancellationReason       String?
  suspendedAt              DateTime?
  suspensionReason         String?
  reactivatedAt            DateTime?
  createdByPlatformAdminId String                    @db.Char(36)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  company                  Company                   @relation(fields: [companyId], references: [id])
  plan                     Plan                      @relation(fields: [planId], references: [id])
  installments             SubscriptionInstallment[]
}

model SubscriptionInstallment {
  id                String                @id @default(uuid()) @db.Char(36)
  subscriptionId    String                @db.Char(36)
  companyId         String                @db.Char(36)
  installmentNumber Int
  description       String
  amount            Decimal               @db.Decimal(15, 2)
  dueDate           DateTime
  paidAmount        Decimal               @default(0) @db.Decimal(15, 2)
  paidAt            DateTime?
  status            InstallmentStatus
  paymentMethod     String?
  externalReference String?
  notes             String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  subscription      Subscription          @relation(fields: [subscriptionId], references: [id])
  payments          SubscriptionPayment[]
}

model SubscriptionPayment {
  id                        String                  @id @default(uuid()) @db.Char(36)
  subscriptionInstallmentId String                  @db.Char(36)
  companyId                 String                  @db.Char(36)
  amount                    Decimal                 @db.Decimal(15, 2)
  paymentMethod             String?
  paidAt                    DateTime
  reference                 String?
  notes                     String?
  createdByPlatformAdminId  String                  @db.Char(36)
  createdAt                 DateTime                @default(now())
  installment               SubscriptionInstallment @relation(fields: [subscriptionInstallmentId], references: [id])
}

model SubscriptionHistory {
  id                       String              @id @default(uuid()) @db.Char(36)
  subscriptionId           String              @db.Char(36)
  companyId                String              @db.Char(36)
  previousStatus           SubscriptionStatus?
  newStatus                SubscriptionStatus
  reason                   String
  metadata                 Json?
  changedByPlatformAdminId String?             @db.Char(36)
  createdAt                DateTime            @default(now())
}

model User {
  id              String          @id @default(uuid()) @db.Char(36)
  name            String
  email           String          @unique
  passwordHash    String
  phone           String?
  status          UserStatus      @default(INVITED)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  members         CompanyMember[]
  pushTokens      PushToken[]
}

model CompanyMember {
  id        String              @id @default(uuid()) @db.Char(36)
  companyId String              @db.Char(36)
  userId    String              @db.Char(36)
  role      CompanyUserRole     @default(MANAGER)
  status    CompanyMemberStatus @default(CONVIDADO)
  isOwner   Boolean             @default(false)
  joinedAt  DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  company   Company             @relation(fields: [companyId], references: [id])
  user      User                @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String?   @db.Char(36)
  platformAdminId  String?   @db.Char(36)
  activeCompanyId  String?   @db.Char(36)
  refreshTokenHash String
  deviceId         String?
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OwnerInvitation {
  id         String    @id @default(uuid()) @db.Char(36)
  companyId  String    @db.Char(36)
  email      String
  name       String
  tokenHash  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String?  @db.Char(36)
  actorType String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

// ─── Fase 2 — Clientes e Catálogo ──────────────────────────────────────────

enum ClientType {
  FISICA
  JURIDICA
}

enum WorkStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum CatalogItemStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id               String            @id @default(uuid()) @db.Char(36)
  companyId        String            @db.Char(36)
  type             ClientType        @default(FISICA)
  name             String
  document         String?
  email            String?
  phone            String?
  whatsapp         String?
  postalCode       String?
  street           String?
  number           String?
  complement       String?
  district         String?
  city             String?
  state            String?
  observations     String?           @db.Text
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  works            Work[]
  quotes           Quote[]
  payments         Payment[]
  productionOrders ProductionOrder[]
  serviceOrders    ServiceOrder[]
  scheduleEvents   ScheduleEvent[]

  @@index([companyId])
  @@index([name])
}

model Work {
  id               String            @id @default(uuid()) @db.Char(36)
  companyId        String            @db.Char(36)
  clientId         String            @db.Char(36)
  name             String
  reference        String?
  postalCode       String?
  street           String?
  number           String?
  complement       String?
  district         String?
  city             String?
  state            String?
  status           WorkStatus        @default(PLANEJADA)
  observations     String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  client           Client            @relation(fields: [clientId], references: [id])
  measurements     Measurement[]
  quotes           Quote[]
  serviceOrders    ServiceOrder[]
  productionOrders ProductionOrder[]

  @@index([companyId])
  @@index([clientId])
}

model Product {
  id          String            @id @default(uuid()) @db.Char(36)
  companyId   String            @db.Char(36)
  name        String
  description String?
  unit        String            @default("un")
  price       Decimal?          @db.Decimal(15, 2)
  cost        Decimal?          @db.Decimal(15, 2)
  status      CatalogItemStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  company     Company           @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Service {
  id          String            @id @default(uuid()) @db.Char(36)
  companyId   String            @db.Char(36)
  name        String
  description String?
  unit        String            @default("serv")
  price       Decimal?          @db.Decimal(15, 2)
  cost        Decimal?          @db.Decimal(15, 2)
  status      CatalogItemStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  company     Company           @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Material {
  id          String              @id @default(uuid()) @db.Char(36)
  companyId   String              @db.Char(36)
  name        String
  description String?
  unit        String              @default("un")
  price       Decimal?            @db.Decimal(15, 2)
  cost        Decimal?            @db.Decimal(15, 2)
  stockQty    Decimal?            @default(0) @db.Decimal(15, 3)
  minStockQty Decimal?            @default(0) @db.Decimal(15, 3)
  status      CatalogItemStatus   @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  company     Company             @relation(fields: [companyId], references: [id])
  movements   InventoryMovement[]

  @@index([companyId])
}

// ─── Fase 3 — Medições e Composições ───────────────────────────────────────

enum MeasurementApplicationType {
  DRYWALL
  FORRO
  PAREDE
  SANCA
  REBAIXAMENTO
  OUTRO
}

model Measurement {
  id                   String                     @id @default(uuid()) @db.Char(36)
  companyId            String                     @db.Char(36)
  workId               String?                    @db.Char(36)
  quoteEnvironmentId   String?                    @db.Char(36)
  environmentName      String
  applicationType      MeasurementApplicationType @default(DRYWALL)
  length               Decimal?                   @db.Decimal(15, 2)
  width                Decimal?                   @db.Decimal(15, 2)
  ceilingHeight        Decimal?                   @db.Decimal(15, 2)
  area                 Decimal?                   @db.Decimal(15, 2)
  perimeter            Decimal?                   @db.Decimal(15, 2)
  doors                Int                        @default(0)
  windows              Int                        @default(0)
  cutouts              Int                        @default(0)
  fixtures             Int                        @default(0)
  hasCove              Boolean                    @default(false)
  hasDropCeiling       Boolean                    @default(false)
  observations         String?                    @db.Text
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime?
  company              Company                    @relation(fields: [companyId], references: [id])
  work                 Work?                      @relation(fields: [workId], references: [id])
  quoteEnvironment     QuoteEnvironment?          @relation(fields: [quoteEnvironmentId], references: [id])

  @@index([companyId])
  @@index([workId])
  @@index([quoteEnvironmentId])
}

// ─── ETAPA 6 — Ambientes de orçamento (sem Work obrigatório) ──────────────────

model QuoteEnvironment {
  id                String        @id @default(uuid()) @db.Char(36)
  companyId         String        @db.Char(36)
  quoteId           String        @db.Char(36)
  name              String
  description       String?       @db.Text
  order             Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  company           Company       @relation(fields: [companyId], references: [id])
  quote             Quote         @relation(fields: [quoteId], references: [id])
  measurements      Measurement[]

  @@index([companyId])
  @@index([quoteId])
}

enum CompositionStatus {
  ACTIVE
  INACTIVE
}

model Composition {
  id              String                     @id @default(uuid()) @db.Char(36)
  companyId       String                     @db.Char(36)
  code            String
  name            String
  version         Int                        @default(1)
  applicationType MeasurementApplicationType
  status          CompositionStatus          @default(ACTIVE)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  deletedAt       DateTime?
  company         Company                    @relation(fields: [companyId], references: [id])
  items           CompositionItem[]

  @@unique([companyId, code, version])
  @@index([companyId])
}

model CompositionItem {
  id            String      @id @default(uuid()) @db.Char(36)
  compositionId String      @db.Char(36)
  materialType  String
  name          String
  unit          String      @default("un")
  formula       Json
  createdAt     DateTime    @default(now())
  composition   Composition @relation(fields: [compositionId], references: [id])

  @@index([compositionId])
}

// ─── Fase 4 — Orçamentos ───────────────────────────────────────────────────

enum QuoteStatus {
  RASCUNHO
  PRONTO_PARA_ENVIAR
  ENVIADO
  AGUARDANDO_APROVACAO
  APROVADO
  REJEITADO
  VENCIDO
  CANCELADO
}

enum QuotePaymentMethod {
  AVISTA
  AVISTA_DESCONTO
  ENTRADA_SALDO
  QUINZENAL_2X
  MENSAL
  PARCELADO
  PERSONALIZADO
}

enum QuoteItemType {
  PRODUTO
  SERVICO
  MATERIAL
  MAO_DE_OBRA
  TRANSPORTE
}

model Quote {
  id              String             @id @default(uuid()) @db.Char(36)
  companyId       String             @db.Char(36)
  clientId        String             @db.Char(36)
  workId          String?            @db.Char(36)
  quoteNumber     Int
  version         Int                @default(1)
  status          QuoteStatus        @default(RASCUNHO)
  subtotal        Decimal            @default(0) @db.Decimal(15, 2)
  discount        Decimal            @default(0) @db.Decimal(15, 2)
  marginPct       Decimal            @default(0) @db.Decimal(5, 2)
  total           Decimal            @default(0) @db.Decimal(15, 2)
  paymentMethod   QuotePaymentMethod @default(AVISTA)
  paymentTerms    String?
  localAddress    Json?
  startDate       DateTime?
  durationDays    Int?
  endDate         DateTime?
  deadlineDate    DateTime?
  visitDate       DateTime?
  measurementDate DateTime?
  warrantyDays    Int?
  validUntil      DateTime?
  observations    String?            @db.Text
  convertedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  company         Company            @relation(fields: [companyId], references: [id])
  client          Client             @relation(fields: [clientId], references: [id])
  work            Work?              @relation(fields: [workId], references: [id])
  items           QuoteItem[]
  history         QuoteHistory[]
  scheduleEvents  ScheduleEvent[]
  serviceOrders   ServiceOrder[]
  environments    QuoteEnvironment[]

  @@unique([companyId, quoteNumber, version])
  @@index([companyId])
  @@index([clientId])
  @@index([workId])
}

model QuoteHistory {
  id        String      @id @default(uuid()) @db.Char(36)
  quoteId   String      @db.Char(36)
  status    QuoteStatus
  changedAt DateTime    @default(now())
  note      String?
  quote     Quote       @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
}

model QuoteItem {
  id          String        @id @default(uuid()) @db.Char(36)
  quoteId     String        @db.Char(36)
  itemType    QuoteItemType
  name        String
  description String?
  quantity    Decimal       @default(1) @db.Decimal(15, 3)
  unit        String        @default("un")
  unitPrice   Decimal       @default(0) @db.Decimal(15, 2)
  total       Decimal       @default(0) @db.Decimal(15, 2)
  createdAt   DateTime      @default(now())
  quote       Quote         @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
}

// ─── Fase 5 — Ordens de Produção ──────────────────────────────────────────

enum ProductionOrderStatus {
  PENDENTE
  EM_PRODUCAO
  CONCLUIDA
  CANCELADA
}

model ProductionOrder {
  id                String                @id @default(uuid()) @db.Char(36)
  companyId         String                @db.Char(36)
  clientId          String?               @db.Char(36)
  workId            String?               @db.Char(36)
  code              Int
  status            ProductionOrderStatus @default(PENDENTE)
  dueDate           DateTime?
  completedDate     DateTime?
  responsiblePerson String?
  observations      String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  company           Company               @relation(fields: [companyId], references: [id])
  client            Client?               @relation(fields: [clientId], references: [id])
  work              Work?                 @relation(fields: [workId], references: [id])
  items             ProductionOrderItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([clientId])
  @@index([workId])
}

model ProductionOrderItem {
  id                String          @id @default(uuid()) @db.Char(36)
  productionOrderId String          @db.Char(36)
  productName       String
  quantity          Decimal         @db.Decimal(15, 3)
  unit              String          @default("un")
  producedQty       Decimal         @default(0) @db.Decimal(15, 3)
  wastedQty         Decimal         @default(0) @db.Decimal(15, 3)
  status            String          @default("PENDENTE")
  createdAt         DateTime        @default(now())
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@index([productionOrderId])
}

// ─── Fase 6 — Ordens de Serviço ────────────────────────────────────────

enum ServiceOrderStatus {
  PENDENTE
  EM_DESLOCAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

// ─── Fase 7 — Estoque (movimentos de inventário) ───────────────────────

enum InventoryMovementType {
  ENTRADA
  SAIDA
  RESERVA
  CONSUMO
  PERDA
  AJUSTE
  RETORNO
}

model ServiceOrder {
  id                 String                 @id @default(uuid()) @db.Char(36)
  companyId          String                 @db.Char(36)
  clientId           String                 @db.Char(36)
  workId             String?                @db.Char(36)
  quoteId            String?                @db.Char(36)
  code               Int
  status             ServiceOrderStatus     @default(PENDENTE)
  scheduledDate      DateTime?
  completedDate      DateTime?
  cost               Decimal?               @db.Decimal(15, 2)
  saleValue          Decimal?               @db.Decimal(15, 2)
  profit             Decimal?               @db.Decimal(15, 2)
  observations       String?                @db.Text
  checklist          Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  company            Company                @relation(fields: [companyId], references: [id])
  client             Client                 @relation(fields: [clientId], references: [id])
  work               Work?                  @relation(fields: [workId], references: [id])
  quote              Quote?                 @relation(fields: [quoteId], references: [id])
  materials          ServiceOrderMaterial[]
  scheduleEvents     ScheduleEvent[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, code])
  @@unique([companyId, quoteId])
  @@index([companyId])
  @@index([clientId])
  @@index([workId])
  @@index([quoteId])
}

model ServiceOrderMaterial {
  id             String       @id @default(uuid()) @db.Char(36)
  serviceOrderId String       @db.Char(36)
  materialName   String
  quantity       Decimal      @db.Decimal(15, 3)
  unit           String       @default("un")
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])

  @@index([serviceOrderId])
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Char(36)
  companyId      String                @db.Char(36)
  materialId     String                @db.Char(36)
  serviceOrderId String?               @db.Char(36)
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(15, 3)
  unitCost       Decimal?              @db.Decimal(15, 2)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  company        Company               @relation(fields: [companyId], references: [id])
  material       Material              @relation(fields: [materialId], references: [id])
  serviceOrder   ServiceOrder?         @relation(fields: [serviceOrderId], references: [id])

  @@index([companyId])
  @@index([materialId])
  @@index([serviceOrderId])
}

// ─── Fase 6 — Financeiro ───────────────────────────────────────────────────

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  CHEQUE
  OUTRO
}

model Payment {
  id               String               @id @default(uuid()) @db.Char(36)
  companyId        String               @db.Char(36)
  clientId         String               @db.Char(36)
  quoteId          String?              @db.Char(36)
  amount           Decimal              @db.Decimal(15, 2)
  paymentMethod    PaymentMethod
  paymentDate      DateTime             @default(now())
  dueDate          DateTime?
  status           PaymentStatus        @default(PENDENTE)
  notes            String?              @db.Text
  receiptUrl       String?
  installmentCount Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  company          Company              @relation(fields: [companyId], references: [id])
  client           Client               @relation(fields: [clientId], references: [id])
  installments     PaymentInstallment[]

  @@index([companyId])
  @@index([clientId])
}

model PaymentInstallment {
  id                String        @id @default(uuid()) @db.Char(36)
  paymentId         String        @db.Char(36)
  companyId         String        @db.Char(36)
  installmentNumber Int
  amount            Decimal       @db.Decimal(15, 2)
  dueDate           DateTime
  paidDate          DateTime?
  status            PaymentStatus @default(PENDENTE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([companyId])
}

enum ExpenseCategory {
  MATERIAL
  MAO_DE_OBRA
  TRANSPORTE
  ALUGUEL
  ENERGIA
  AGUA
  INTERNET
  TELEFONE
  MARKETING
  IMPOSTOS
  OUTROS
}

model Expense {
  id           String          @id @default(uuid()) @db.Char(36)
  companyId    String          @db.Char(36)
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(15, 2)
  expenseDate  DateTime        @default(now())
  receiptUrl   String?
  observations String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  company      Company         @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ─── Fase 7 — Agenda ────────────────────────────────────────────────────────

enum ScheduleEventType {
  VISITA
  MEDICAO
  INICIO
  INSTALACAO
  PRODUCAO
  RETORNO
  ACABAMENTO
  ENTREGA
  COBRANCA
  OUTRO
}

enum ScheduleEventStatus {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

model ScheduleEvent {
  id             String              @id @default(uuid()) @db.Char(36)
  companyId      String              @db.Char(36)
  type           ScheduleEventType
  title          String?
  clientId       String?             @db.Char(36)
  serviceOrderId String?             @db.Char(36)
  quoteId        String?             @db.Char(36)
  date           DateTime
  time           String?
  notes          String?             @db.Text
  status         ScheduleEventStatus @default(AGENDADO)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  company        Company             @relation(fields: [companyId], references: [id])
  client         Client?             @relation(fields: [clientId], references: [id])
  serviceOrder   ServiceOrder?       @relation(fields: [serviceOrderId], references: [id])
  quote          Quote?              @relation(fields: [quoteId], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@index([serviceOrderId])
  @@index([quoteId])
  @@index([date])
}

// ─── Fase 8 — Notificações Push ────────────────────────────────────────────

enum PushTokenPlatform {
  ANDROID
  IOS
}

model PushToken {
  id        String            @id @default(uuid()) @db.Char(36)
  companyId String            @db.Char(36)
  userId    String            @db.Char(36)
  token     String            @db.VarChar(512)
  platform  PushTokenPlatform @default(ANDROID)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  company   Company           @relation(fields: [companyId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([companyId, token])
  @@index([companyId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Char(36)
  companyId String   @db.Char(36)
  type      String   @default("GENERIC")
  title     String
  body      String   @db.Text
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}
